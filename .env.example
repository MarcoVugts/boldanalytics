# Dune
DUNE_API_KEY=
DUNE_QUERY_TRADES=9084141     # sql/dune/trades_daily.sql
DUNE_QUERY_ROUTES=9084177     # sql/dune/routes.sql
DUNE_PERFORMANCE=medium       # medium | large (large costs more credits)
DUNE_EXPORT_CREDITS_PER_MB=10 # result export pricing: Analyst 10, Plus 2 (used for the cost estimate)
DUNE_USD_PER_CREDIT=0.01875   # plan price / credits (Analyst $75 / 4000); /ops client statement
# DUNE_API_BASE=http://localhost:4010/api/v1   # local mock: node scripts/mock-dune.mjs

# Database (set automatically by the Neon integration on Vercel)
DATABASE_URL=

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=

# Incremental loading
INGEST_OVERLAP_DAYS=0              # re-fetch N already-loaded days (each costs a full day of export)
INGEST_MAX_DAYS_PER_RUN=7          # backfill chunk size; call the route again to continue
INGEST_MAX_EXPORT_CREDITS=50       # don't pull results whose export would cost more than this
