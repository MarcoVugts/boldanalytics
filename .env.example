# Dune
DUNE_API_KEY=
DUNE_QUERY_TRADES=            # id of the saved query from sql/dune/trades_daily.sql
DUNE_PERFORMANCE=medium       # medium | large (large costs more credits)
# DUNE_API_BASE=http://localhost:4010/api/v1   # local mock: node scripts/mock-dune.mjs

# Database (set automatically by the Neon integration on Vercel)
DATABASE_URL=

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=

# Incremental loading
INGEST_BACKFILL_START=2026-08-12   # first run starts here
INGEST_OVERLAP_DAYS=1              # re-fetch the newest loaded day once (late-indexed data)
INGEST_MAX_DAYS_PER_RUN=14         # backfill chunk size; call the route again to continue
